{
  "expo": {
    "name": "Stasis",
    "slug": "stasis",
    "scheme": "stasis",
    "version": "1.0.0",
    "ios": {
      "bundleIdentifier": "com.vishal.stasis",
      "backgroundColor": "#F8FAFC"
    },
    "android": {
      "package": "com.vishal.stasis",
      "backgroundColor": "#F8FAFC",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "stasis"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-share-intent",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6180028035971404~9839816245",
          "iosAppId": "ca-app-pub-6180028035971404~1497302115",
          "userTrackingPermission": "Stasis needs your permission to track your activity across apps and websites to deliver personalized sponsor videos."
        }
      ]
    ],
    "owner": "shahvishal662",
    "extra": {
      "eas": {
        "projectId": "cdadbbfd-8e8a-4641-a4a6-c40e1a36704a"
      }
    }
  }
}
